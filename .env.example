# Server-side only. Never expose to the browser.
# Copy this file to .env.local and fill in real values.

# CoinMarketCap API key (Startup tier or higher for this hackathon)
# Get one at https://coinmarketcap.com/api
CMC_API_KEY=

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: used by the AI explainer in Market Lab.
# If empty, the explainer falls back to a deterministic local template.
ANTHROPIC_API_KEY=

# Optional: used by the Coin Story generator on the /ancestor page.
# When set, the LLM writes the first-person story grounded in Tavily
# research. When empty, /ancestor falls back to a deterministic
# "I am <Name>." sketch from the verified facts only.
# (Same key as the AI explainer; one Anthropic account covers both.)
# Already covered above by ANTHROPIC_API_KEY — no separate key needed.

# Tavily — used by the ancestor engine to classify coin kinds via live
# web lookups, and by the Coin Story feature to research historical
# facts about each cryptocurrency.
TAVILY_API_KEY=