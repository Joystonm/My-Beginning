{
  "name": "who-is-my-ancestor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "ancestor:calc": "tsx scripts/calculate-ancestors.ts",
    "test:hierarchy": "tsx scripts/test-hierarchy.ts",
    "test:stories": "tsx --import ./scripts/test-loader.ts scripts/test-story-orchestrator.ts",
    "test:auth": "tsx --import ./scripts/test-loader.ts scripts/test-auth-redirect.ts",
    "story": "tsx --env-file=.env.local scripts/generate-story.ts",
    "story:stream": "tsx --env-file=.env.local scripts/generate-story.ts --stream",
    "test": "npm run test:hierarchy && npm run test:stories && npm run test:auth"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@tavily/core": "^0.7.11",
    "clsx": "^2.1.1",
    "next": "^14.2.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
